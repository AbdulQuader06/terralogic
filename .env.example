# ================================================================
# TerraLogic — Environment Variables
# Copy this file to `.env` for LOCAL development.
# In Render, set these in the Environment tab (or group "terralogic-env").
# ================================================================

# ---- Network ----
PORT=5000
NODE_ENV=development

# ---- Security (REQUIRED in production) ----
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# In Render, this is auto-generated by render.yaml (generateValue: true)
SESSION_SECRET=replace_me_with_a_secure_random_string_min_32_bytes

# ---- CORS (optional, comma-separated origins) ----
# Example: https://app.example.com,https://admin.example.com
# CORS_ORIGIN=

# ---- AI Integrations (optional — without them the local GIS engine is used) ----
# Google Gemini / GenAI
# NOTE: BOTH variable names below work — code accepts either.
#       AI_INTEGRATIONS_GEMINI_API_KEY takes priority if both are set.
AI_INTEGRATIONS_GEMINI_API_KEY=
GEMINI_API_KEY=
AI_INTEGRATIONS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# OpenAI / ChatGPT
# NOTE: BOTH variable names below work — code accepts either.
AI_INTEGRATIONS_OPENAI_API_KEY=
OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# ---- ArcGIS (optional — used for basemap layers and geocoding) ----
# NOTE: BOTH variable names below work — code accepts either.
ARCGIS_API_KEY=
ESRI_API_KEY=